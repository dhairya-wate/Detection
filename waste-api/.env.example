# Copy this file to .env and fill in your values.
# Lines beginning with # are comments.

# Path to the ONNX model (inside the container or on the host for local dev)
MODEL_PATH=models/best.onnx

# Path to the material rules JSON
RULES_PATH=config/rules.json

# Detection thresholds
CONF_THRES=0.4
IOU_THRES=0.5

# Maximum upload size in megabytes
MAX_UPLOAD_MB=10

# ONNX Runtime intra-op thread count (tune to CPU cores)
ONNX_THREADS=2

# API Key for /predict endpoint authentication (leave blank to disable)
API_KEY=

# Comma-separated CORS origins (leave blank to disable CORS middleware)
# Example: CORS_ORIGINS=http://localhost:3000,https://myapp.example.com
CORS_ORIGINS=

# Number of Uvicorn worker processes (tune to CPU cores)
WEB_CONCURRENCY=2
